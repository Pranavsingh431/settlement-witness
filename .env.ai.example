# Hosted-model settings for the corpus-only shadow run.
#
# Copy this file to .env.ai, fill in the three blank values, and load it into
# your shell before running the command:
#
#     cp .env.ai.example .env.ai
#     # edit .env.ai
#     set -a; source .env.ai; set +a
#     uv run python -m app.ai.live_shadow --allow-network --output results/live.json
#
# .env.ai is ignored by git. Never commit a real key, and never paste one into
# an issue, a log or a run receipt. The receipt the command writes carries the
# model and the settings and never the key.
#
# These are read from the process environment, not from the backend .env file.
# The backend reads SW_-prefixed settings from .env; these are separate on
# purpose, so a credential is not sitting in the file the application loads on
# every start.
#
# There is no default endpoint, no default model and no default key. A missing
# or blank value stops the command before any network client is built.

# The OpenAI-compatible base URL, without a trailing slash. The command appends
# /chat/completions. Must be https, unless it names localhost for a fake server.
SETTLEMENT_WITNESS_AI_BASE_URL=

# Your API key. Sent in an Authorization header and nowhere else.
SETTLEMENT_WITNESS_AI_API_KEY=

# The model identifier, exactly as the host names it. Recorded in the receipt,
# because a score means nothing without knowing what produced it.
SETTLEMENT_WITNESS_AI_MODEL=

# How long one request may take. One attempt, never retried.
SETTLEMENT_WITNESS_AI_TIMEOUT_SECONDS=30

# The largest response body that will be read. A larger one is abandoned unread.
SETTLEMENT_WITNESS_AI_MAX_RESPONSE_BYTES=32768

# How many requests one run may send. The corpus is 24 pages, so 24 is one pass
# over it. A lower number stops early rather than costing more than intended.
SETTLEMENT_WITNESS_AI_MAX_REQUESTS=24
