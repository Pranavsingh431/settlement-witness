# Copy this file to .env and edit the values for your machine.
# The .env file is ignored by git. Never commit real credentials.
# Every backend setting is read with the SW_ prefix.

# Which environment the backend believes it is running in.
# Allowed values: local, test, ci, production.
SW_APP_ENV=local

# How much the backend logs. Allowed values: DEBUG, INFO, WARNING, ERROR.
SW_LOG_LEVEL=INFO

# Address the backend binds to when you run `make dev`.
SW_API_HOST=127.0.0.1
SW_API_PORT=8000

# Optional managed-database URL. It is required when SW_APP_ENV=production and
# must be configured in the deployment platform's secret store, never here.
# SW_DATABASE_URL=postgresql+psycopg://...

# Largest CSV document POST /v1/imports will accept, in bytes.
# An upload past this is refused with 413 before it is parsed, so it never
# reaches the import service and leaves no receipt.
SW_MAX_UPLOAD_BYTES=8388608
